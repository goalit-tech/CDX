{
  "name": "campusdesk",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-studentdashboard": "cds watch --open cdx.ui.usr.studentdashboard/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/studentdashboard"
  ],
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "password": "Admin@123",
            "roles": [
              "admin"
            ]
          },
          "faculty": {
            "password": "Faculty@123",
            "roles": [
              "faculty"
            ]
          }
        }
      }
    }
  }
}
