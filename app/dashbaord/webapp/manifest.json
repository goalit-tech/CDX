{
  "_version": "1.84.0",
  "sap.app": {
    "id": "cdx.ui.dashbaord",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.24.0",
      "toolsId": "4c4867c3-6574-4fc7-ba12-1c2cab6595b6"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/organization/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {},
        "sap.fe.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "cdx.ui.dashbaord.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "OrganizationMain",
          "pattern": ":?query:",
          "target": "OrganizationMain"
        },
        {
          "name": "AcademicYear",
          "pattern": "academic-year:?query:",
          "target": "AcademicYear"
        },
        {
          "name": "Organizations",
          "pattern": "organizations:?query:",
          "target": "Organizations"
        },
        {
          "name": "CalendarEvents",
          "pattern": "calendar-events:?query:",
          "target": "CalendarEvents"
        },
        {
          "name": "Campus",
          "pattern": "campus:?query:",
          "target": "Campus"
        },
        {
          "name": "Grade",
          "pattern": "grade:?query:",
          "target": "Grade"
        },
        {
          "name": "Section",
          "pattern": "section:?query:",
          "target": "Section"
        },
        {
          "name": "Employees",
          "pattern": "employees:?query:",
          "target": "Employees"
        },
        {
          "name": "Students",
          "pattern": "students:?query:",
          "target": "Students"
        },
        {
          "name": "Enrollment",
          "pattern": "enrollment:?query:",
          "target": "Enrollment"
        },
        {
          "name": "Roles",
          "pattern": "roles:?query:",
          "target": "Roles"
        },
        {
          "name": "RoleAssignments",
          "pattern": "role-assignments:?query:",
          "target": "RoleAssignments"
        },
        {
          "name": "UserAccounts",
          "pattern": "user-accounts:?query:",
          "target": "UserAccounts"
        }
      ],
      "targets": {
        "OrganizationMain": {
          "type": "Component",
          "id": "OrganizationMain",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Organization",
              "viewName": "cdx.ui.dashbaord.view.Landing"
            }
          }
        },
        "AcademicYear": {
          "type": "Component",
