<mvc:View
    controllerName="cdx.ui.dashbaord.view.Landing"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
    height="100%"
>
    <mvc:dependents>
        <Menu id="userMenu">
            <!-- <MenuItem id="logoutMenuItem" text="{app>navLogout}" icon="sap-icon://log" press="onLogout"/> -->
            <MenuItem id="logoutMenuItem" text="{i18n>navLogout}" icon="sap-icon://log" press="onLogout"/>
        </Menu>
    </mvc:dependents>
    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader id="toolHeader">
                <Button id="menuButton" icon="sap-icon://menu2" type="Transparent" tooltip="{i18n>toggleNav}" press="onToggleSideNav"/>
                <Title id="headerTitle" text="{i18n>appTitle}" level="H2" titleStyle="H5" wrapping="false" class="sapUiTinyMarginBegin"/>
                <ToolbarSpacer id="headerSpacer"/>
                <Text id="userNameText" text="{app>/displayName}" wrapping="false" width="8rem" textAlign="End" class="sapUiTinyMarginEnd"/>
                <Avatar id="userAvatar" initials="{app>/initials}" displaySize="XS" tooltip="{i18n>userMenu}" press="onAvatarPress"/>
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNav" itemSelect="onItemSelect">
                <tnt:NavigationList id="mainNavList">
                    <tnt:NavigationListItem id="navItemHome" text="{i18n>navHome}" key="home" icon="sap-icon://home"/>
                    <tnt:NavigationListItem id="navItemOrgSetup" text="{i18n>navOrgSetup}" icon="sap-icon://org-chart" expanded="true">
                        <tnt:items>
                            <tnt:NavigationListItem id="navItemOrganization" text="{i18n>navOrganizations}" key="organization" icon="sap-icon://building"/>
                            <tnt:NavigationListItem id="navItemAcademicYear" text="{i18n>navAcademicYear}" key="academic-year" icon="sap-icon://calendar"/>
                            <tnt:NavigationListItem id="navItemCalendarEvent" text="{i18n>navCalendarEvent}" key="calendar-event" icon="sap-icon://appointment-2"/>
                            <tnt:NavigationListItem id="navItemCampus" text="{i18n>navCampus}" key="campus" icon="sap-icon://retail-store"/>
                            <tnt:NavigationListItem id="navItemGrade" text="{i18n>navGrade}" key="grade" icon="sap-icon://education"/>
                            <tnt:NavigationListItem id="navItemSection" text="{i18n>navSection}" key="section" icon="sap-icon://list"/>
                        </tnt:items>
                    </tnt:NavigationListItem>
                    <tnt:NavigationListItem id="navItemUserMgmt" text="{i18n>navUserMgmt}" icon="sap-icon://group">
                        <tnt:items>
                            <tnt:NavigationListItem id="navItemEmployee" text="{i18n>navEmployee}" key="employee" icon="sap-icon://employee"/>
                            <tnt:NavigationListItem id="navItemStudent" text="{i18n>navStudent}" key="student" icon="sap-icon://student"/>
                            <tnt:NavigationListItem id="navItemEnrollment" text="{i18n>navEnrollment}" key="enrollment" icon="sap-icon://add-employee"/>
                            <tnt:NavigationListItem id="navItemRole" text="{i18n>navRole}" key="role" icon="sap-icon://key-user-settings"/>
                            <tnt:NavigationListItem id="navItemRoleAssignment" text="{i18n>navRoleAssignment}" key="role-assignment" icon="sap-icon://user-settings"/>
                        </tnt:items>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <Page id="homePage" showHeader="false" class="sapUiContentPadding">
                <VBox id="homeContentBox">
                    <Title id="welcomeTitle" text="{app>/welcomeText}" level="H2" class="sapUiSmallMarginBottom"/>
                    <Text id="landingSubtitleText" text="{i18n>landingSubtitle}" class="sapUiMediumMarginBottom"/>
                    <FlexBox id="tileGrid" wrap="Wrap" class="cdxTileGrid">
                        <GenericTile id="tileOrganization" header="{i18n>navOrganizations}" subheader="{i18n>tileOrganizationsSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="organization"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentOrganization"><content><core:Icon id="tileIconOrganization" src="sap-icon://building" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile id="tileAcademicYear" header="{i18n>navAcademicYear}" subheader="{i18n>tileComingSoonSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="academic-year"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentAcademicYear"><content><core:Icon id="tileIconAcademicYear" src="sap-icon://calendar" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile id="tileCalendarEvent" header="{i18n>navCalendarEvent}" subheader="{i18n>tileComingSoonSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="calendar-event"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentCalendarEvent"><content><core:Icon id="tileIconCalendarEvent" src="sap-icon://appointment-2" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile id="tileCampus" header="{i18n>navCampus}" subheader="{i18n>tileComingSoonSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="campus"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentCampus"><content><core:Icon id="tileIconCampus" src="sap-icon://retail-store" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile id="tileGrade" header="{i18n>navGrade}" subheader="{i18n>tileComingSoonSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="grade"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentGrade"><content><core:Icon id="tileIconGrade" src="sap-icon://education" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile id="tileSection" header="{i18n>navSection}" subheader="{i18n>tileComingSoonSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="section"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentSection"><content><core:Icon id="tileIconSection" src="sap-icon://list" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile id="tileEmployee" header="{i18n>navEmployee}" subheader="{i18n>tileComingSoonSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="employee"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentEmployee"><content><core:Icon id="tileIconEmployee" src="sap-icon://employee" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile id="tileStudent" header="{i18n>navStudent}" subheader="{i18n>tileComingSoonSubtitle}" press="onTilePress" class="sapUiSmallMargin">
                            <customData>
                                <core:CustomData key="target" value="student"/>
                            </customData>
                            <tileContent>
                                <TileContent id="tileContentStudent"><content><core:Icon id="tileIconStudent" src="sap-icon://student" size="2rem"/></content></TileContent>
                            </tileContent>
                        </GenericTile>
                    </FlexBox>
                </VBox>
            </Page>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
