<mvc:View
    controllerName="cdx.ui.dashbaord.view.AcademicYear"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
    height="100%"
>
    <Page id="academicYearPage" title="{i18n>navAcademicYear}" showNavButton="true" navButtonPress="onNavBack">
        <content>
            <IllustratedMessage
                id="academicYearMessage"
                illustrationType="sapIllus-NoData"
                title="{i18n>navAcademicYear}"
                description="{i18n>comingSoonDescription}"
            />
        </content>
    </Page>
</mvc:View>